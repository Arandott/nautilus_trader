# Aurora Lattice live trading sample credentials/configuration
# Copy this file to `.env` inside Aurora_Lattice/ and fill in real values
# before running `python -m Aurora_Lattice.run_live_trading`.

# --- Binance (required when any client uses venue="BINANCE") ---
BINANCE_API_KEY=replace_me
BINANCE_API_SECRET=replace_me

# --- OKX (required when any client uses venue="OKX") ---
OKX_API_KEY=replace_me
OKX_API_SECRET=replace_me
OKX_API_PASSPHRASE=replace_me
