# ========================================
# FactorExp Live Trading - Environment Configuration
# ========================================
# 
# This template shows all available environment variables for the FactorExp Live Trading System.
# Copy this file to `.env` and configure with your actual values.
#
# IMPORTANT: The system now uses StrategyConfig classes for most trading parameters.
# Environment variables are only used for API keys, trading mode, and system settings.

# ========================================
# 🔐 CRITICAL: API CREDENTIALS (REQUIRED)
# ========================================
# Get these from your Binance account:
# 1. Go to https://www.binance.com/en/my/settings/api-management
# 2. Create a new API key with "Enable Futures" permission
# 3. For testnet: https://testnet.binancefuture.com/

BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_secret_key_here

# ========================================
# 🎯 TRADING CONFIGURATION
# ========================================

# Trading mode: 'testnet' for safe testing, 'live' for real trading
# ALWAYS start with testnet to test your configuration!
TRADING_MODE=testnet

# Account size in USD (optional) - enables automatic small account optimization
# Examples: 200, 500, 1000
# Leave blank or set to 'Standard' for default configuration
ACCOUNT_SIZE_USD=

# ========================================
# 🔔 ALERTING & NOTIFICATIONS (OPTIONAL)
# ========================================

# Email alerts (requires SMTP configuration below)
ENABLE_EMAIL_ALERTS=false

# Webhook alerts for Discord, Slack, etc.
ENABLE_WEBHOOK_ALERTS=false

# Webhook URL for notifications (if enabled)
WEBHOOK_URL=

# ========================================
# 📧 EMAIL CONFIGURATION (OPTIONAL)
# ========================================
# Only needed if ENABLE_EMAIL_ALERTS=true

EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_TO=your_notifications@gmail.com

# ========================================
# ⚙️ SYSTEM SETTINGS (OPTIONAL)
# ========================================

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Portfolio monitoring update interval (seconds)
PORTFOLIO_UPDATE_INTERVAL_SEC=5

# Enable structured JSON logging
ENABLE_STRUCTURED_LOGGING=true

# Enable portfolio change alerts
ENABLE_PORTFOLIO_ALERTS=true

# Alert threshold for P&L changes (percentage)
ALERT_THRESHOLD_PNL_PCT=0.02

# ========================================
# 📊 STRATEGY CONFIGURATION NOTES
# ========================================
#
# 🎯 IMPORTANT: Most trading parameters are now configured via StrategyConfig classes!
# 
# The following parameters are NO LONGER configured via environment variables:
# ❌ MAX_POSITION_SIZE_BTC (now: position_risk_pct in StrategyConfig)
# ❌ MAX_DAILY_LOSS_USD (now: max_daily_loss_usd in StrategyConfig)  
# ❌ MAX_DRAWDOWN_PCT (now: max_drawdown_pct in StrategyConfig)
# ❌ STOP_LOSS_PCT (now: stop_loss_pct in StrategyConfig)
# ❌ TAKE_PROFIT_PCT (now: take_profit_pct in StrategyConfig)
#
# These are now configured using type-safe StrategyConfig classes:
# 
# ✅ Standard Account Configuration:
#    - max_account_usage_pct: 80%
#    - position_risk_pct: 2%  
#    - stop_loss_pct: 1.5%
#    - max_daily_trades: 20
#
# ✅ Small Account Configuration (≤$500):
#    - max_account_usage_pct: 60%
#    - position_risk_pct: 1.5%
#    - stop_loss_pct: 1.2%  
#    - max_daily_trades: 10
#
# 📖 See examples/small_account_example.py for configuration examples
# 📖 See config/strategy_config.py for all available parameters

# ========================================
# 🚀 QUICK START GUIDE
# ========================================
#
# 1. Copy this file: cp .env.template .env
# 2. Configure your Binance API credentials above
# 3. Set TRADING_MODE=testnet for testing
# 4. Optionally set your ACCOUNT_SIZE_USD for optimization
# 5. Run: python start_trading.py
#
# 🔒 Security Tips:
# - Never commit your .env file to version control
# - Use testnet first to validate your setup
# - Keep your API keys secure and never share them
# - Use read-only API keys when possible for monitoring

